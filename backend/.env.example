# Copy to .env and fill in before running `docker compose up -d` (EC2 or local).
# JWT_SECRET is required — docker-compose fails fast if it's missing.
JWT_SECRET=

# Where the OAuth success redirect sends the browser with ?token=...
FRONTEND_URL=http://localhost:5173

# Kakao Developers console
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver Developers console
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Naver CLOVA OCR (General) — ticket face-price verification
NAVER_OCR_INVOKE_URL=
NAVER_OCR_SECRET_KEY=

# Toss Payments test secret key — escrow/payment confirmation
TOSS_TEST_SECRET_KEY=
